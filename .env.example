# CrewAI / main LLM
GLM_API_KEY=
GLM_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# CTINexus KG generation. If unset, the adapter falls back to OPENAI_* then GLM_*.
CTINEXUS_API_KEY=
CTINEXUS_BASE_URL=

# Source APIs
NVD_API_KEY=

# Web UI
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=8000

# Base KG pipeline (base_kg/). LLM falls back to OPENAI_* then GLM_*.
BASEKG_LLM_MODEL=glm-4.7
BASEKG_LLM_BASE_URL=
BASEKG_LLM_API_KEY=
BASEKG_EMBEDDING_MODEL=text-embedding-3-large

# Neo4j (docker compose up -d neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=basekg-dev-2026
