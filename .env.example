# CrewAI / main LLM
GLM_API_KEY=
GLM_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Intel collection engine (docs/INTEL_AGENT_SDK_ROADMAP.md).
# rules = deterministic baseline (default); sdk = claude-agent-sdk engine
# (needs `uv sync --group agentsdk` and an Anthropic-compatible endpoint key).
INTEL_ENGINE=rules
# Anthropic-compatible provider for the sdk engine: deepseek | glm.
# Unset = auto-detect (deepseek if DEEPSEEK_API_KEY present, else glm).
INTEL_SDK_PROVIDER=
# DeepSeek Anthropic-compatible endpoint (https://api.deepseek.com/anthropic).
DEEPSEEK_API_KEY=
# Optional model overrides (defaults: deepseek-v4-pro / deepseek-v4-flash).
DEEPSEEK_MODEL=
DEEPSEEK_FAST_MODEL=
# Optional sdk-engine model tiers; default to the provider's model vars.
INTEL_SDK_MODEL=
INTEL_SDK_FAST_MODEL=
# Termination safety floor (max_rounds stays the hard cap).
INTEL_MIN_ROUNDS=1
# Three-tier relevance filter (rule -> embedding -> flash LLM); set 0 to disable.
INTEL_RELEVANCE_ENABLED=1
INTEL_EMBEDDING_MODEL=embedding-3
INTEL_RELEVANCE_JUDGE_MODEL=

# CTINexus KG generation. If unset, the adapter falls back to OPENAI_* then GLM_*.
CTINEXUS_API_KEY=
CTINEXUS_BASE_URL=

# Source APIs
NVD_API_KEY=

# Web UI
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=8000

# Base KG pipeline (base_kg/). LLM falls back to OPENAI_* then GLM_*.
BASEKG_LLM_MODEL=glm-4.7
BASEKG_LLM_BASE_URL=
BASEKG_LLM_API_KEY=
BASEKG_EMBEDDING_MODEL=text-embedding-3-large

# Neo4j (docker compose up -d neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=basekg-dev-2026

# Base KG speed-up knobs (all optional)
# Comma-separated key pool for parallel extraction; defaults to GLM_API_KEY + GLM_API_KEY_1..9
BASEKG_LLM_API_KEYS=
BASEKG_CONCURRENCY=8
BASEKG_NER_MODEL=GLM-4.7-FlashX
BASEKG_STD_MODEL=GLM-4.7-FlashX
BASEKG_RE_MODEL=glm-4.7
BASEKG_FILTER_MODEL=glm-4.7-flash
BASEKG_REQUEST_INTERVAL=2
BASEKG_DISABLE_THINKING=0
