\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Same-budget A/B results across nine frozen goals (mean of three runs each; R = deterministic \texttt  {\relax \fontsize  {9}{10pt}\selectfont  rules}, S = agentic \texttt  {\relax \fontsize  {9}{10pt}\selectfont  sdk}). \textbf  {Coverage completeness} (depth quota $q=3$) is the primary metric. The \texttt  {\relax \fontsize  {9}{10pt}\selectfont  sdk} engine is never below the baseline on coverage and far above it on the hard and multi-topic goals, trading per-call efficiency for that completeness. Bold marks the better engine where the gap is material.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:ab}{{II}{7}{Same-budget A/B results across nine frozen goals (mean of three runs each; R = deterministic \code {rules}, S = agentic \code {sdk}). \textbf {Coverage completeness} (depth quota $q=3$) is the primary metric. The \code {sdk} engine is never below the baseline on coverage and far above it on the hard and multi-topic goals, trading per-call efficiency for that completeness. Bold marks the better engine where the gap is material}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Same-budget comparison per goal. (a) Coverage completeness, the primary objective: the agent matches or exceeds the baseline everywhere and closes the gaps the fixed policy cannot (ATA $0.00\!\to \!1.00$). (b) Per-call efficiency is the price paid for that coverage---higher on PI/JB/DL, lower where sparse topics must be chased. Error bars: $\pm 1$ s.d.\ over three runs (the deterministic baseline is exactly reproducible, zero variance).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:bars}{{3}{7}{Same-budget comparison per goal. (a) Coverage completeness, the primary objective: the agent matches or exceeds the baseline everywhere and closes the gaps the fixed policy cannot (ATA $0.00\!\to \!1.00$). (b) Per-call efficiency is the price paid for that coverage---higher on PI/JB/DL, lower where sparse topics must be chased. Error bars: $\pm 1$ s.d.\ over three runs (the deterministic baseline is exactly reproducible, zero variance)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Coverage--efficiency trade-off. Each arrow runs from a goal's deterministic point to its agentic point. Every goal moves \emph  {rightward} to higher coverage (the sparse-topic goals ATA and SRD travel furthest, from $0.0$/$0.33$ to $1.0$/$0.78$); per-call efficiency rises or falls depending on how sparse the topics it must still reach are.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:tradeoff}{{4}{7}{Coverage--efficiency trade-off. Each arrow runs from a goal's deterministic point to its agentic point. Every goal moves \emph {rightward} to higher coverage (the sparse-topic goals ATA and SRD travel furthest, from $0.0$/$0.33$ to $1.0$/$0.78$); per-call efficiency rises or falls depending on how sparse the topics it must still reach are}{figure.4}{}}
